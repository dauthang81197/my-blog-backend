{
   "name": "my-blog-backend",
   "version": "0.0.1",
   "description": "Awesome project developed with TypeORM.",
   "type": "commonjs",
   "devDependencies": {
      "@types/bcrypt": "^5.0.2",
      "@types/express": "^5.0.0",
      "@types/jsonwebtoken": "^9.0.9",
      "@types/memory-cache": "^0.2.6",
      "@types/node": "^16.11.10",
      "nodemon": "^3.1.9",
      "ts-node": "10.9.1",
      "typescript": "4.5.2"
   },
   "dependencies": {
      "@types/cors": "^2.8.17",
      "bcrypt": "^5.1.1",
      "concurrently": "^9.1.2",
      "dotenv": "^16.4.7",
      "express": "^4.21.2",
      "jsonwebtoken": "^9.0.2",
      "memory-cache": "^0.2.0",
      "pg": "^8.4.0",
      "reflect-metadata": "^0.1.13",
      "swagger-autogen": "^2.23.7",
      "swagger-jsdoc": "^6.2.8",
      "swagger-ui-express": "^5.0.1",
      "typeorm": "0.3.20"
   },
   "scripts": {
      "watch": "tsc -w",
      "dev": "nodemon build/index.js",
      "start:dev": "concurrently \"tsc -w\" \"nodemon build/index.js\"",
      "build": "tsc",
      "start": "nodemon --exec ts-node src/index.ts",
      "typeorm": "typeorm-ts-node-commonjs",
      "migration-run": "npm run typeorm migration:run -- -d ./src/databases/data-source.ts",
      "migration-generate": "npm run typeorm migration:generate -- -d ./src/databases/data-source.ts"
   }
}